# Copy this file to .env and replace every REPLACE_* value before running.
# .env is gitignored and must never be committed.

# OpenAI-compatible model endpoint used by search_agent/chat_client.py.
# For a model served on this same GPU, keep 127.0.0.1 and VLLM_PORT.
MODEL_BASE_URL=http://127.0.0.1:10100/v1
MODEL_API_KEY=EMPTY
MODEL_NAME=CrowtherLabs/Qwythos-9B-Analyst

# Authenticated BrowseComp-Plus retrieval API. This is normally a separate
# retrieval GPU because the hybrid reranker and the model compete for VRAM.
BCP_RETRIEVAL_URL=http://180.189.55.38:48912
BCP_TOKEN=REPLACE_WITH_CURRENT_RETRIEVAL_BEARER_TOKEN
BCP_REQUIRE_RETRIEVAL_EXCLUSIONS=0

# Azure judge. The benchmark can run without these, but the live evaluator and
# scripts/remote/start_stack.sh require all four values.
AZURE_OPENAI_API_KEY=REPLACE_WITH_AZURE_OPENAI_API_KEY
AZURE_OPENAI_ENDPOINT=https://procureai.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21

# Optional public/private Hugging Face access used to download the base model,
# adapter, and the encrypted BrowseComp test set.
HF_TOKEN=REPLACE_WITH_HF_TOKEN
HF_USERNAME=REPLACE_WITH_HF_USERNAME
HF_HOME=/workspace/huggingface

# vLLM serving configuration for the standalone base model. No LoRA adapter
# fields are required for CrowtherLabs/Qwythos-9B-Analyst.
BASE_MODEL=CrowtherLabs/Qwythos-9B-Analyst
VLLM_HOST=0.0.0.0
VLLM_PORT=10100
VLLM_MAX_MODEL_LEN=131072
VLLM_GPU_MEMORY_UTILIZATION=0.92
VLLM_MAX_NUM_SEQS=2
VLLM_LANGUAGE_MODEL_ONLY=1
VLLM_LOG_FILE=runs/vllm.log

# Benchmark defaults. Change RUN_NAME for every treatment/experiment; resume
# by using the same name and output directory.
RUN_NAME=qwythos-9b-analyst-remote
QUERY_FILE=topics-qrels/queries.tsv
NUM_THREADS=2
MAX_TOKENS=12000
MAX_ITERATIONS=64
MAX_TOOL_CALLS=32
TEMPERATURE=0.25
TOP_P=0.95
TOP_K=20
REPETITION_PENALTY=1.05
SEARCH_K=10
SNIPPET_MAX_TOKENS=512
DOCUMENT_MAX_TOKENS=4096
QUERY_TEMPLATE=QUERY_TEMPLATE_RESEARCH_LEDGER
RETRIEVAL_NOVELTY=server
RETRIEVAL_SEEN_ANCHOR_COUNT=2
ENABLE_CONTEXT_COMPACTION=1
CONTEXT_WINDOW_TOKENS=131072
CONTEXT_COMPACTION_TRIGGER_TOKENS=98304
CONTEXT_COMPACTION_KEEP_TOOL_ROUNDS=2
CONTEXT_COMPACTION_MAX_TOKENS=1536
CONTEXT_COMPACTION_RESERVE_TOKENS=8192
ENABLE_EVIDENCE_NOTES=1
ENABLE_FRESH_FINAL=1
ENABLE_MULTI_QUERY_SEARCH=1
ENABLE_DEEP_POOL_SEARCH=1
DEEP_POOL_K=100

# Optional Phase 1 ensemble treatment. Use a different RUN_NAME and output
# directory from single-rollout experiments; the four seeds are recorded in
# each aggregate run file.
ENSEMBLE_ROLLOUTS=4
ENSEMBLE_TEMPERATURES=0.2,0.6,0.6,0.8
ENSEMBLE_SEED_BASE=4100
ENSEMBLE_PARALLEL_ROLLOUTS=4
ENSEMBLE_POOL_MAX_CHARS=60000

# Dashboard/evaluator.
DASHBOARD_PORT=7860
EVAL_POLL_INTERVAL=15
